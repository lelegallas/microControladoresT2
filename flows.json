    {
        "id": "pulsos",
        "type": "function",
        "z": "45d04d89ca5dbc41",
        "name": "Liga a bobina 2x",
        "func": "// Relé ativo em 0: 0 = liga, 1 = desliga\nconst sequencia = [0, 1, 0, 1];\nsequencia.forEach((nivel, i) => {\n    setTimeout(() => node.send([{ payload: nivel }, null]), i * 500);\n});\n\nconst hora = new Date().toLocaleTimeString(\"pt-BR\");\nnode.warn(\"Jogou água (\" + msg.payload + \")\");\nreturn [null, { payload: hora + \" (\" + msg.payload + \")\" }];",
        "outputs": 2,
        "x": 780,
        "y": 720,
        "wires": [
            [
                "bobina"
            ],
            [
                "texto_ultima"
            ]
        ]
    },
