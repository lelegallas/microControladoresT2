    {
        "id": "decide",
        "type": "function",
        "z": "45d04d89ca5dbc41",
        "name": "Verifica umidade",
        "func": "let dados;\ntry {\n    dados = JSON.parse(msg.payload);\n} catch (e) {\n    node.error(\"Saída inválida: \" + msg.payload);\n    return null;\n}\n\nif (dados.erro) {\n    node.error(\"Erro no sensor: \" + dados.erro);\n    return null;\n}\n\nconst msgUmidade = { topic: \"Umidade\", payload: dados.umidade };\nconst msgLuz = { topic: \"Luz\", payload: dados.luz };\n\nlet regar = null;\nif (dados.umidade > 60000) {\n    regar = { payload: \"automático\" };\n}\n\n// saída 1 = umidade, saída 2 = luz, saída 3 = ordem de regar\nreturn [msgUmidade, msgLuz, regar];",
        "outputs": 3,
        "x": 520,
        "y": 640,
        "wires": [
            [
                "gauge_umidade",
                "grafico"
            ],
            [
                "gauge_luz",
                "grafico"
            ],
            [
                "pulsos"
            ]
        ]
    },
